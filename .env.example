# Copy to .env and fill in. NEVER commit .env.

DO_TOKEN=

# --- GPU capacity ----------------------------------------------------------
# Spot capacity is a SIZE SLUG, not a flag — `doctl compute droplet create` has no --spot.
# Each single-GPU spot size is offered in exactly one region, so region and slug move together:
#   gpu-mi350x1-288gb-spot   ric1 in the reference run
#   gpu-mi355x1-288gb-spot   mem1 fallback in the reference run
# Re-check before each run: `doctl compute size list -o json` carries a per-size regions list,
# and spot prices move daily.
SPOT_SIZE_SLUG=gpu-mi350x1-288gb-spot
REGION=ric1
FALLBACK_SIZE_SLUG=gpu-mi355x1-288gb-spot
FALLBACK_REGION=mem1

# Image availability changes. Choose a current AMD AI/ML image offered in both
# the primary and fallback regions, then complete the README preflight checks.
IMAGE_SLUG=

SSH_KEY_ID=                # doctl compute ssh-key list (must match a private key you hold)

# --- Spaces ----------------------------------------------------------------
# Keep Spaces in the primary GPU region so transfer measurements are same-region.
# Use a globally unique bucket name and a bucket-scoped read/write key.
SPACES_KEY=
SPACES_SECRET=
SPACES_ENDPOINT=https://ric1.digitaloceanspaces.com
SPACES_BUCKET=your-unique-checkpoint-bucket

# --- Controller droplet (created by 00_controller.sh, IP filled after) -----
# s-1vcpu-1gb is NOT offered in the GPU regions, so the controller lives in nyc3.
CONTROLLER_IP=
CONTROLLER_PORT=8080
CONTROLLER_REGION=nyc3

# Auth for the drill's own surfaces (generate: openssl rand -hex 16)
DRILL_TOKEN=
# Redis is opt-in, only for queue_demo/. Set ENABLE_REDIS=1 and a REDIS_PASSWORD to install it.
ENABLE_REDIS=0
REDIS_PASSWORD=

# GPU-droplet tag; controller gets ${DRILL_TAG}-ctrl so --all teardown can't touch it
DRILL_TAG=spot-drill
# --- Drill container (PHASE-1 FINDING) -------------------------------------
# Set this to the compatible rocm/pytorch image found during the manual preflight.
DRILL_IMAGE=
DRILL_CONTAINER=drill


# --- Phase-0 recon finding (required) --------------------------------------
# Set this only after checking lsblk/findmnt on the current image. Never guess:
# bootstrap formats this device after verifying it is not the root filesystem.
SCRATCH_DEV=

# NOTE: rotate the Spaces keys after the demo (phase 6).

# --- Serving half (SERVING.md; not used by the drill) -----------------------
# Read by serving/cluster/*.sh only. Nothing here is sent to a GPU node.
# The GPU pool defaults to SPOT_SIZE_SLUG in REGION. Its autoscaling range is fixed at
# creation: DOKS does not allow a Spot GPU pool's maximum to be raised afterwards.
SERVING_CLUSTER=spot-drill-serving
SERVING_REGION=
SERVING_GPU_SIZE=
SERVING_GPU_MIN=1
SERVING_GPU_MAX=2
# No default. Pick a CPU size DOKS offers in the GPU region: serving/cluster/00_preflight.sh
# lists them. The one CPU node carries KEDA, Prometheus and the load generator, so the
# smallest size will not do; 4 vCPU is a safe choice.
SERVING_CPU_SIZE=
SERVING_CPU_COUNT=1
SERVING_K8S_VERSION=latest
# Hard budget for one serving session, in USD. The preflight turns it into a stop time.
SERVING_BUDGET_USD=80
